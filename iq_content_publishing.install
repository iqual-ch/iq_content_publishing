<?php

/**
 * @file
 * Install, update and uninstall functions for iq_content_publishing.
 */

declare(strict_types=1);

/**
 * Implements hook_uninstall().
 */
function iq_content_publishing_uninstall(): void {
  $entity_type_manager = \Drupal::entityTypeManager();

  // Delete all publishing_platform config entities.
  if ($entity_type_manager->hasDefinition('publishing_platform')) {
    $storage = $entity_type_manager->getStorage('publishing_platform');
    $ids = $storage->getQuery()->accessCheck(FALSE)->execute();
    if (!empty($ids)) {
      $entities = $storage->loadMultiple($ids);
      $storage->delete($entities);
    }
  }

  // Delete the module's settings config.
  \Drupal::configFactory()->getEditable('iq_content_publishing.settings')->delete();

  // Purge any remaining queue items.
  \Drupal::queue('iq_content_publishing')->deleteQueue();

}

/**
 * Add tool_id field to publishing_log entity.
 */
function iq_content_publishing_update_10001(): void {
  $entity_type_manager = \Drupal::entityTypeManager();
  $entity_definition_update_manager = \Drupal::entityDefinitionUpdateManager();

  $field_storage_definition = \Drupal\Core\Field\BaseFieldDefinition::create('string')
    ->setLabel(t('Tool ID'))
    ->setDescription(t('The tool identifier for multi-tool platforms (e.g. social:4, content:2). NULL for single-tool platforms.'))
    ->setSettings(['max_length' => 255]);

  $entity_definition_update_manager->installFieldStorageDefinition(
    'tool_id',
    'publishing_log',
    'iq_content_publishing',
    $field_storage_definition,
  );
}
